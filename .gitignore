# =============================================================================
#  Nairobi Flood Digital Twin — .gitignore
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# ---- Virtual Environment ----
.venv/
venv/
env/

# ---- Environment secrets ----
.env

# ---- Data & Model artefacts (large files) ----
data/raw/*
data/processed/*
data/spatial/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/spatial/.gitkeep
!models/.gitkeep

# The v2 segmentation dataset is deliberately tracked (~1.8 MB), so Colab can
# pull it with the repo instead of needing a Google Drive upload. It is small
# because rainfall is stored as 7 scalars per sample and terrain as one shared
# array, rather than 77 channels of mostly duplicated maps.
#
# Three lines are required, in this order. Git cannot re-include a file whose
# parent directory is excluded, so the directory must first be un-ignored to let
# git descend into it; its contents are then re-ignored, and finally the single
# file is allowed. Omitting the middle line un-ignores the entire directory,
# which sweeps in ~6.5 GB of intermediate .npy arrays.
!data/processed/arrays/
data/processed/arrays/*
!data/processed/arrays/segmentation_dataset_v2*.npz
!data/processed/arrays/population_grid_worldpop2025.npy
!data/processed/arrays/population_grid_worldpop2025.json

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Generated debug artefacts ----
test_map.html
logs/*.log

# ---- Local scenario database (see src/persistence/) ----
data/scenarios.db

# Local database files (generated by DatabaseManager.initialise)
data/*.db
data/*.sqlite

# Place-name gazetteer is tracked: ~30 KB, and committing it means the
# dashboard never depends on Overpass being reachable at runtime.
!data/processed/nairobi_places.json

# Road network for flood-aware routing: ~2.4 MB compressed, tracked for the
# same reason (src/ingestion/fetch_road_network.py refreshes it).
!data/processed/nairobi_roads.json.gz

# Offline location search index (~0.3 MB), refreshed by
# src/ingestion/fetch_search_index.py.
!data/processed/nairobi_search_index.json.gz

# Archived hourly rainfall for the storm replays, so they work offline.
!data/processed/replay_rainfall.json
!data/processed/rainfall_bias_correction.json

# Small evaluation outputs travel with the code; model weights (100+ MB) do not.
# Same three-line idiom as data/processed/arrays above.
!models/time_series/
models/time_series/*
!models/time_series/calibration_v2_*.json
!models/time_series/evaluation_v2_*.json
!models/time_series/crossval_v2_*.json
!models/time_series/backtest_live_pipeline.json
