# =============================================================================
#  Nairobi Flood Digital Twin — Environment Variables
#  Copy to `.env` and fill in real values. Never commit `.env` to Git.
# =============================================================================

# ---- Google Earth Engine ----
# Service-account JSON key path for EE authentication
GEE_SERVICE_ACCOUNT_KEY=path/to/ee-service-account-key.json
# GCP project ID linked to the Earth Engine API
GEE_PROJECT_ID=your-gee-cloud-project-id
# Optional: Earth Engine high-volume endpoint toggle
GEE_HIGH_VOLUME=false

# ---- Mapbox ----
# Public access token for Pydeck / Mapbox GL basemap tiles
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
# Default map style URI used by the dashboard canvas
MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# ---- File Paths ----
# Override default data and model directories if needed
DATA_DIR=./data
MODELS_DIR=./models
CONFIG_DIR=./config
SPATIAL_DIR=./data/spatial

# ---- Runtime Tuning ----
# Maximum number of parallel data-loading workers
MAX_WORKERS=4
# Training batch size (auto-scaled down by MemoryGuard if RSS > 12 GB)
BATCH_SIZE=16
# Random seed for reproducibility across runs
RANDOM_SEED=42

# ---- Memory Guard-Rails (override defaults from MEMORY_CONSTRAINTS.md) ----
MEMORY_RSS_WARN_GB=12.0
MEMORY_RSS_CRITICAL_GB=14.0
MEMORY_TENSOR_MAX_GB=2.0
MEMORY_TORCH_RESERVED_WARN_GB=8.0

# ---- Accounts and access control (src/auth) ----
# Signs session cookies. Use a long random value in production, e.g. the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unset: a key is generated once and kept in TWIN_STATE_DIR/secret_key.
TWIN_SECRET_KEY=
# First administrator, created on start-up only if no active admin exists. They
# set up an authenticator app (2FA) at their first sign-in. Remove the password
# from the environment after the first start.
TWIN_ADMIN_EMAIL=
TWIN_ADMIN_PASSWORD=
# Google accounts (comma separated) that become administrators on sign-in.
TWIN_ADMIN_EMAILS=
# Set to 1 when served over HTTPS (Railway), so the session cookie is HTTPS-only.
TWIN_COOKIE_SECURE=0

# ---- Google and email-link sign-in (Firebase Authentication) ----
# Firebase console -> Project settings -> Your apps -> Web app config. These are
# public identifiers, not secrets; no service-account key is needed.
# In Authentication -> Sign-in method, enable Google and Email/Password with
# "Email link (passwordless sign-in)". Leave FIREBASE_PROJECT_ID empty to offer
# email + password only.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ---- Dash Server ----
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=true
